{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node18",
    "lib": ["ES2023"],
    "types": ["node"],

    "declaration": true,
    "outDir": ".",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["index.ts"],
  "exclude": ["node_modules", "test"]
}
